# ---- Gnani Speech APIs (required for voice) — server-side only, never shipped to browsers ----
# Get a key at https://app.gnani.ai (sent as the X-API-Key-ID header).
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v2.5          # Prisma v2.5 (default) — prisma-v3.0 also available
GNANI_STT_DEFAULT_LANGUAGE=en-IN     # en-IN accepts Hindi-English mixed speech, Latin output
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Poorvi               # Timbre v2.5 Hinglish voice
GNANI_TTS_LANGUAGE=hi-en
GNANI_TTS_VOICE_EN=Kaveri

# ---- Reasoning provider (optional; default is the deterministic Hinglish rule planner) ----
PLANNER=auto                         # auto | rules | openai_compat  (the LLM runs only when rules can't)
# Any OpenAI-compatible endpoint. Tested: OpenAI (https://api.openai.com/v1, gpt-5.4-mini).
# Also possible: Gnani Evon v3.3 self-hosted with SGLang/vLLM (LLM_MODEL=gnani/gnani-evon-v3.3-30B-A3B).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-5.4-mini
LLM_REASONING_EFFORT=low

# ---- Server ----
PUBLIC_URL=                          # e.g. https://perry.example.com (used in pairing QR links)
DB_PATH=data/perry.db
SECRET_KEY=                          # signs short-lived audio URLs; auto-generated if empty
APPROVAL_MODE=standard               # standard | strict (strict also gates opening apps/URLs)
CORS_ORIGINS=                        # only if the web app is hosted on another origin
HOST=127.0.0.1
PORT=8787
